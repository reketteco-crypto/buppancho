  @@unique([transactionId, accountId, purpose], map: "money_entry_unique")
  @@index([accountId, transactionId])
  @@map("money_entry")
}

model SupplyItem {
  id             String                 @id @default(uuid()) @db.Uuid
  workspaceId    String                 @map("workspace_id") @db.Uuid
  businessUnitId String                 @map("business_unit_id") @db.Uuid
  name           String
  memo           String?
  kind           String
  unit           String                 @default("点")
  active         Boolean                @default(true)
  revision       Int                    @default(0)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  purchases      PurchaseDocumentLine[]
  skuSettings    SkuSupplySetting[]
  uses           MaterialUse[]

  @@index([workspaceId, businessUnitId, kind])
  @@map("supply_item")
}

model SkuSupplySetting {
  id           String     @id @default(uuid()) @db.Uuid
  skuId        String     @map("sku_id") @db.Uuid
  supplyItemId String     @map("supply_item_id") @db.Uuid
  purpose      String
  quantity     Decimal    @db.Decimal(20, 8)
  unitCostJpy  Decimal?   @map("unit_cost_jpy") @db.Decimal(24, 8)
  sku          SalesSku   @relation(fields: [skuId], references: [id], onDelete: Restrict)
  supplyItem   SupplyItem @relation(fields: [supplyItemId], references: [id], onDelete: Restrict)

  @@unique([skuId, supplyItemId, purpose])
  @@map("sku_supply_setting")
}

model MaterialUse {
  id                String       @id @default(uuid()) @db.Uuid
  workspaceId       String       @map("workspace_id") @db.Uuid
  businessUnitId    String       @map("business_unit_id") @db.Uuid
  reportingEntityId String       @map("reporting_entity_id") @db.Uuid
  saleId            String       @map("sale_id") @db.Uuid
  supplyItemId      String       @map("supply_item_id") @db.Uuid
  supplyName        String       @map("supply_name")
  purchaseLineId    String?      @map("purchase_line_id") @db.Uuid
  purpose           String
  quantity          Decimal      @db.Decimal(20, 8)
  unitCostJpy       Decimal?     @map("unit_cost_jpy") @db.Decimal(24, 8)
  costJpy           BigInt?      @map("cost_jpy") @db.BigInt
  costFinal         Boolean      @map("cost_final")
  date              DateTime     @db.Date
  reason            String?
  supersedesId      String?      @unique @map("supersedes_id") @db.Uuid
  supersedes        MaterialUse? @relation("material_use_revision", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy      MaterialUse? @relation("material_use_revision")
  requestId         String       @map("request_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  supplyItem        SupplyItem   @relation(fields: [supplyItemId], references: [id], onDelete: Restrict)
  sale              SalesOrder   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([workspaceId, businessUnitId, date])
  @@map("material_use")
}

model MoneyCategory {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  name        String
  kind        String
  active      Boolean       @default(true)
  revision    Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  records     OtherRecord[]

  @@unique([workspaceId, name, kind])
  @@map("money_category")
}

model OtherRecord {
  id                String        @id @default(uuid()) @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  businessUnitId    String        @map("business_unit_id") @db.Uuid
  reportingEntityId String        @map("reporting_entity_id") @db.Uuid
  date              DateTime      @db.Date
  kind              String
  categoryId        String        @map("category_id") @db.Uuid
  categoryName      String        @map("category_name")
  amountJpy         BigInt        @map("amount_jpy") @db.BigInt
  sourceSaleId      String?       @map("source_sale_id") @db.Uuid
  sourcePurchaseId  String?       @map("source_purchase_id") @db.Uuid
  counterparty      String?
  memo              String?
  reversesId        String?       @unique @map("reverses_id") @db.Uuid
  reverses          OtherRecord?  @relation("other_record_reversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy        OtherRecord?  @relation("other_record_reversal")
  requestId         String        @unique @map("request_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  category          MoneyCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([workspaceId, businessUnitId, date])
  @@map("other_record")
}

model OwnerSettlementAllocation {
  id                  String           @id @default(uuid()) @db.Uuid
  settlementId        String           @map("settlement_id") @db.Uuid
  sourceTransactionId String           @map("source_transaction_id") @db.Uuid
  amountJpy           BigInt           @map("amount_jpy") @db.BigInt
  settlement          MoneyTransaction @relation("owner_settlement", fields: [settlementId], references: [id], onDelete: Restrict)
  source              MoneyTransaction @relation("owner_source", fields: [sourceTransactionId], references: [id], onDelete: Restrict)

  @@unique([settlementId, sourceTransactionId])
  @@index([sourceTransactionId])
  @@map("owner_settlement_allocation")
}
