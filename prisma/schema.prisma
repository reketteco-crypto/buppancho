generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  ADMIN @map("admin")

  @@map("account_role")
}

enum EntityType {
  INDIVIDUAL @map("individual")

  @@map("entity_type")
}

enum FilingMethod {
  BLUE  @map("blue")
  WHITE @map("white")

  @@map("filing_method")
}

enum ConsumptionTaxStatus {
  EXEMPT             @map("exempt")
  TAXABLE            @map("taxable")
  INVOICE_REGISTERED @map("invoice_registered")

  @@map("consumption_tax_status")
}

enum BlueDeductionTarget {
  NONE           @map("none")
  DEDUCTION_100K @map("100k")
  DEDUCTION_550K @map("550k")
  DEDUCTION_650K @map("650k")

  @@map("blue_deduction_target")
}

enum InventoryValuationMethod {
  SPECIFIC           @map("specific")
  LAST_PURCHASE_COST @map("last_purchase_cost")
  GROSS_AVERAGE      @map("gross_average")
  OTHER              @map("other")

  @@map("inventory_valuation_method")
}

enum FiscalYearStatus {
  OPEN    @map("open")
  CLOSING @map("closing")
  LOCKED  @map("locked")

  @@map("fiscal_year_status")
}

enum CounterpartyType {
  SUPPLIER @map("supplier")
  CUSTOMER @map("customer")
  AGENT    @map("agent")
  CARRIER  @map("carrier")
  OTHER    @map("other")

  @@map("counterparty_type")
}

enum SequenceKind {
  ITEM      @map("item")
  VARIANT   @map("variant")
  UNIT      @map("unit")
  PURCHASE  @map("purchase")
  SALES_SKU @map("sales_sku")

  @@map("sequence_kind")
}

enum ItemConditionCategory {
  UNSPECIFIED @map("unspecified")
  NEW         @map("new")
  USED        @map("used")

  @@map("item_condition_category")
}

enum InventoryManagementType {
  QUANTITY @map("quantity")
  UNIQUE   @map("unique")

  @@map("inventory_management_type")
}

enum ManagementCostMethod {
  MOVING_AVERAGE @map("moving_average")
  FIFO           @map("fifo")
  SPECIFIC       @map("specific")

  @@map("management_cost_method")
}

enum InventoryItemStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("inventory_item_status")
}

enum InventoryCostStatus {
  PROVISIONAL @map("provisional")
  FINAL       @map("final")

  @@map("inventory_cost_status")
}

enum UniqueStockStatus {
  SUPPLIER_RETURNED  @map("supplier_returned")
  IN_STOCK           @map("in_stock")
  RESERVED           @map("reserved")
  SOLD               @map("sold")
  RETURNED           @map("returned")
  DISPOSED           @map("disposed")
  LOST               @map("lost")
  PERSONAL_USE       @map("personal_use")
  PURCHASE_CANCELLED @map("purchase_cancelled")

  @@map("unique_stock_status")
}

enum PurchaseType {
  DOMESTIC        @map("domestic")
  RAKUMART_IMPORT @map("rakumart_import")
  USED_BUNDLE     @map("used_bundle")
  OTHER           @map("other")

  @@map("purchase_type")
}

enum PurchaseStatus {
  DRAFT              @map("draft")
  ORDERED            @map("ordered")
  PAID               @map("paid")
  PARTIALLY_RECEIVED @map("partially_received")
  RECEIVED           @map("received")
  COSTING            @map("costing")
  FINALIZED          @map("finalized")
  CANCELLED          @map("cancelled")

  @@map("purchase_status")
}

enum InventoryOperationType {
  PURCHASE_RETURN   @map("purchase_return")
  STOCKTAKE         @map("stocktake")
  PURCHASE_RECEIPT  @map("purchase_receipt")
  PURCHASE_REVERSAL @map("purchase_reversal")
  LOCATION_TRANSFER @map("location_transfer")
  DISPOSAL          @map("disposal")
  LOSS              @map("loss")
  PERSONAL_USE      @map("personal_use")
  ADJUSTMENT_IN     @map("adjustment_in")
  ADJUSTMENT_OUT    @map("adjustment_out")
  SALE_COMPLETION   @map("sale_completion")
  SALE_RETURN       @map("sale_return")

  @@map("inventory_operation_type")
}

enum StockMovementType {
  PURCHASE_RETURN   @map("purchase_return")
  RECEIPT           @map("receipt")
  RECEIPT_REVERSAL  @map("receipt_reversal")
  LOCATION_TRANSFER @map("location_transfer")
  DISPOSAL          @map("disposal")
  LOSS              @map("loss")
  PERSONAL_USE      @map("personal_use")
  ADJUSTMENT_IN     @map("adjustment_in")
  ADJUSTMENT_OUT    @map("adjustment_out")
  SALE_OUT          @map("sale_out")
  RETURN_IN         @map("return_in")
  RETURN_DEFECTIVE  @map("return_defective")
  RETURN_DISPOSAL   @map("return_disposal")

  @@map("stock_movement_type")
}

enum SalesChannelType {
  MERCARI          @map("mercari")
  RAKUMA           @map("rakuma")
  YAHOO_FLEAMARKET @map("yahoo_fleamarket")
  MERCARI_SHOPS    @map("mercari_shops")
  OTHER            @map("other")

  @@map("sales_channel_type")
}

enum SalesSkuType {
  SINGLE @map("single")
  BUNDLE @map("bundle")

  @@map("sales_sku_type")
}

enum ListingStatus {
  DRAFT    @map("draft")
  ACTIVE   @map("active")
  PAUSED   @map("paused")
  SOLD_OUT @map("sold_out")
  ENDED    @map("ended")

  @@map("listing_status")
}

enum SalesOrderStatus {
  DRAFT               @map("draft")
  CONFIRMED           @map("confirmed")
  AWAITING_SHIPMENT   @map("awaiting_shipment")
  SHIPPED             @map("shipped")
  AWAITING_COMPLETION @map("awaiting_completion")
  COMPLETED           @map("completed")
  CANCELLED           @map("cancelled")
  RETURNED            @map("returned")

  @@map("sales_order_status")
}

enum ReservationStatus {
  RESERVED @map("reserved")
  CONSUMED @map("consumed")
  RELEASED @map("released")

  @@map("reservation_status")
}

enum ShipmentStatus {
  PENDING   @map("pending")
  SHIPPED   @map("shipped")
  DELIVERED @map("delivered")
  RETURNED  @map("returned")

  @@map("shipment_status")
}

enum ReturnDisposition {
  RESTOCK   @map("restock")
  DEFECTIVE @map("defective")
  DISPOSED  @map("disposed")

  @@map("return_disposition")
}

model Workspace {
  revision            Int                  @default(0)
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  timezone            String               @default("Asia/Tokyo")
  baseCurrency        String               @default("JPY") @map("base_currency")
  setupCompletedAt    DateTime?            @map("setup_completed_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  operators           Operator[]
  userAccounts        UserAccount[]
  reportingEntities   ReportingEntity[]
  businessUnits       BusinessUnit[]
  auditLogs           AuditLog[]
  storageLocations    StorageLocation[]
  counterparties      Counterparty[]
  sequences           WorkspaceSequence[]
  inventoryItems      InventoryItem[]
  itemVariants        ItemVariant[]
  uniqueStockUnits    UniqueStockUnit[]
  purchases           Purchase[]
  inventoryOperations InventoryOperation[]
  salesChannels       SalesChannel[]
  salesSkus           SalesSku[]
  salesOrders         SalesOrder[]

  @@map("workspace")
}

model Operator {
  revision              Int                      @default(0)
  id                    String                   @id @default(uuid()) @db.Uuid
  workspaceId           String                   @map("workspace_id") @db.Uuid
  displayName           String                   @map("display_name")
  active                Boolean                  @default(true)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace             Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  defaultAssignments    BusinessUnitAssignment[] @relation("DefaultAssignmentOperator")
  sessions              AuthSession[]
  auditLogs             AuditLog[]
  inventoryOperations   InventoryOperation[]
  stockMovements        StockMovement[]
  listingPriceHistories ListingPriceHistory[]
  salesOrderEvents      SalesOrderEvent[]

  @@unique([workspaceId, displayName])
  @@index([workspaceId, active])
  @@map("operator")
}

model UserAccount {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  loginName      String        @map("login_name")
  normalizedName String        @unique @map("normalized_name")
  passwordHash   String        @map("password_hash")
  role           AccountRole   @default(ADMIN)
  active         Boolean       @default(true)
  lastLoginAt    DateTime?     @map("last_login_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sessions       AuthSession[]
  auditLogs      AuditLog[]

  @@unique([workspaceId, normalizedName])
  @@map("user_account")
}

model AuthSession {
  id                   String        @id @default(uuid()) @db.Uuid
  userAccountId        String        @map("user_account_id") @db.Uuid
  tokenHash            String        @unique @map("token_hash")
  activeOperatorId     String?       @map("active_operator_id") @db.Uuid
  activeBusinessUnitId String?       @map("active_business_unit_id") @db.Uuid
  selectedYear         Int?          @map("selected_year") @db.SmallInt
  expiresAt            DateTime      @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt    DateTime      @map("absolute_expires_at") @db.Timestamptz(3)
  lastSeenAt           DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt            DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  userAccount          UserAccount   @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  activeOperator       Operator?     @relation(fields: [activeOperatorId], references: [id], onDelete: SetNull)
  activeBusinessUnit   BusinessUnit? @relation(fields: [activeBusinessUnitId], references: [id], onDelete: SetNull)

  @@index([userAccountId, revokedAt])
  @@map("auth_session")
}

model AuthLoginThrottle {
  normalizedName  String    @id @map("normalized_name")
  failureCount    Int       @default(0) @map("failure_count")
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("auth_login_throttle")
}

model ReportingEntity {
  revision           Int                 @default(0)
  id                 String              @id @default(uuid()) @db.Uuid
  workspaceId        String              @map("workspace_id") @db.Uuid
  displayName        String              @map("display_name")
  entityType         EntityType          @default(INDIVIDUAL) @map("entity_type")
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  fiscalYearProfiles FiscalYearProfile[]
  purchases          Purchase[]
  salesOrders        SalesOrder[]

  @@unique([workspaceId, displayName])
  @@index([workspaceId, active])
  @@map("reporting_entity")
}

model FiscalYearProfile {
  revision                     Int                      @default(0)
  id                           String                   @id @default(uuid()) @db.Uuid
  reportingEntityId            String                   @map("reporting_entity_id") @db.Uuid
  year                         Int                      @db.SmallInt
  filingMethod                 FilingMethod             @map("filing_method")
  consumptionTaxStatus         ConsumptionTaxStatus     @map("consumption_tax_status")
  blueDeductionTarget          BlueDeductionTarget      @map("blue_deduction_target")
  inventoryValuationMethod     InventoryValuationMethod @map("inventory_valuation_method")
  inventoryValuationMethodNote String?                  @map("inventory_valuation_method_note")
  startDate                    DateTime                 @map("start_date") @db.Date
  endDate                      DateTime                 @map("end_date") @db.Date
  status                       FiscalYearStatus         @default(OPEN)
  lockedAt                     DateTime?                @map("locked_at") @db.Timestamptz(3)
  createdAt                    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  reportingEntity              ReportingEntity          @relation(fields: [reportingEntityId], references: [id], onDelete: Restrict)
  assignments                  BusinessUnitAssignment[]

  @@unique([reportingEntityId, year])
  @@index([year, status])
  @@map("fiscal_year_profile")
}

model BusinessUnit {
  revision            Int                      @default(0)
  id                  String                   @id @default(uuid()) @db.Uuid
  workspaceId         String                   @map("workspace_id") @db.Uuid
  code                String
  name                String
  color               String
  active              Boolean                  @default(true)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace           Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  assignments         BusinessUnitAssignment[]
  activeSessions      AuthSession[]
  storageLocations    StorageLocation[]
  inventoryItems      InventoryItem[]
  costBalances        InventoryCostBalance[]
  purchases           Purchase[]
  inventoryOperations InventoryOperation[]
  stockMovements      StockMovement[]
  salesSkus           SalesSku[]
  salesOrders         SalesOrder[]

  @@unique([workspaceId, code])
  @@unique([workspaceId, name])
  @@index([workspaceId, active])
  @@map("business_unit")
}

model BusinessUnitAssignment {
  revision            Int               @default(0)
  id                  String            @id @default(uuid()) @db.Uuid
  businessUnitId      String            @map("business_unit_id") @db.Uuid
  fiscalYearProfileId String            @map("fiscal_year_profile_id") @db.Uuid
  defaultOperatorId   String?           @map("default_operator_id") @db.Uuid
  effectiveFrom       DateTime          @map("effective_from") @db.Date
  effectiveTo         DateTime          @map("effective_to") @db.Date
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  businessUnit        BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  fiscalYearProfile   FiscalYearProfile @relation(fields: [fiscalYearProfileId], references: [id], onDelete: Restrict)
  defaultOperator     Operator?         @relation("DefaultAssignmentOperator", fields: [defaultOperatorId], references: [id], onDelete: Restrict)

  @@unique([businessUnitId, fiscalYearProfileId, effectiveFrom])
  @@index([businessUnitId, effectiveFrom, effectiveTo])
  @@index([defaultOperatorId])
  @@map("business_unit_assignment")
}

model AuditLog {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String       @map("workspace_id") @db.Uuid
  userAccountId String?      @map("user_account_id") @db.Uuid
  operatorId    String?      @map("operator_id") @db.Uuid
  action        String
  entityType    String       @map("entity_type")
  entityId      String       @map("entity_id") @db.Uuid
  beforeJson    Json?        @map("before_json")
  afterJson     Json?        @map("after_json")
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  requestId     String?      @map("request_id")
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  userAccount   UserAccount? @relation(fields: [userAccountId], references: [id], onDelete: SetNull)
  operator      Operator?    @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

model StorageLocation {
  revision                    Int                          @default(0)
  id                          String                       @id @default(uuid()) @db.Uuid
  workspaceId                 String                       @map("workspace_id") @db.Uuid
  businessUnitId              String?                      @map("business_unit_id") @db.Uuid
  code                        String
  name                        String
  active                      Boolean                      @default(true)
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace                   Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  businessUnit                BusinessUnit?                @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  defaultForItems             InventoryItem[]
  receivedLots                InventoryLot[]
  uniqueStockUnits            UniqueStockUnit[]
  movementsFrom               StockMovement[]              @relation("MovementFrom")
  movementsTo                 StockMovement[]              @relation("MovementTo")
  purchases                   Purchase[]
  inventoryReservations       InventoryReservation[]
  orderComponentConsumptions  OrderComponentConsumption[]
  returnComponentDispositions ReturnComponentDisposition[]

  @@unique([workspaceId, code])
  @@index([workspaceId, active])
  @@index([businessUnitId])
  @@map("storage_location")
}

model Counterparty {
  defaultCurrency         String           @default("JPY") @map("default_currency")
  defaultAllocationMethod String           @default("VALUE") @map("default_allocation_method")
  revision                Int              @default(0)
  id                      String           @id @default(uuid()) @db.Uuid
  workspaceId             String           @map("workspace_id") @db.Uuid
  name                    String
  type                    CounterpartyType @default(SUPPLIER)
  currency                String           @default("JPY")
  memo                    String?
  active                  Boolean          @default(true)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace               Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  purchases               Purchase[]

  @@unique([workspaceId, name, type])
  @@index([workspaceId, type, active])
  @@map("counterparty")
}

model WorkspaceSequence {
  workspaceId String       @map("workspace_id") @db.Uuid
  kind        SequenceKind
  nextValue   BigInt       @default(1) @map("next_value") @db.BigInt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, kind])
  @@map("workspace_sequence")
}

model InventoryItem {
  revision                 Int                     @default(0)
  id                       String                  @id @default(uuid()) @db.Uuid
  workspaceId              String                  @map("workspace_id") @db.Uuid
  businessUnitId           String                  @map("business_unit_id") @db.Uuid
  itemCode                 String                  @map("item_code")
  name                     String
  category                 String?
  defaultConditionCategory ItemConditionCategory   @default(UNSPECIFIED) @map("default_condition_category")
  managementType           InventoryManagementType @map("management_type")
  /// DB制約により数量管理はMOVING_AVERAGE、個体管理はSPECIFICのみ許可する。
  managementCostMethod     ManagementCostMethod    @map("management_cost_method")
  defaultStorageLocationId String?                 @map("default_storage_location_id") @db.Uuid
  status                   InventoryItemStatus     @default(ACTIVE)
  memo                     String?
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace                Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  businessUnit             BusinessUnit            @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  defaultStorageLocation   StorageLocation?        @relation(fields: [defaultStorageLocationId], references: [id], onDelete: Restrict)
  variants                 ItemVariant[]

  @@unique([workspaceId, itemCode])
  @@index([workspaceId, businessUnitId, status])
  @@index([name])
  @@map("inventory_item")
}

model ItemVariant {
  id                          String                       @id @default(uuid()) @db.Uuid
  workspaceId                 String                       @map("workspace_id") @db.Uuid
  inventoryItemId             String                       @map("inventory_item_id") @db.Uuid
  variantCode                 String                       @map("variant_code")
  attributesJson              Json                         @default("{}") @map("attributes_json")
  active                      Boolean                      @default(true)
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  inventoryItem               InventoryItem                @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  workspace                   Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  inventoryLots               InventoryLot[]
  uniqueStockUnits            UniqueStockUnit[]
  costBalances                InventoryCostBalance[]
  purchaseLines               PurchaseLine[]
  stockMovements              StockMovement[]
  salesSkuComponents          SalesSkuComponent[]
  inventoryReservations       InventoryReservation[]
  orderComponentConsumptions  OrderComponentConsumption[]
  returnComponentDispositions ReturnComponentDisposition[]

  @@unique([inventoryItemId, variantCode])
  @@unique([workspaceId, variantCode])
  @@index([inventoryItemId, active])
  @@map("item_variant")
}

model InventoryLot {
  documentReceiptLine         PurchaseReceiptLine?
  id                          String                       @id @default(uuid()) @db.Uuid
  itemVariantId               String                       @map("item_variant_id") @db.Uuid
  trackingMode                InventoryManagementType      @map("tracking_mode")
  purchaseLineId              String?                      @unique @map("purchase_line_id") @db.Uuid
  receivedDate                DateTime                     @map("received_date") @db.Date
  receivedQuantity            Int                          @map("received_quantity")
  remainingQuantity           Int                          @map("remaining_quantity")
  landedCostTotalJpy          BigInt                       @map("landed_cost_total_jpy") @db.BigInt
  unitCostJpy                 Decimal                      @map("unit_cost_jpy") @db.Decimal(20, 6)
  costStatus                  InventoryCostStatus          @default(FINAL) @map("cost_status")
  storageLocationId           String                       @map("storage_location_id") @db.Uuid
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  itemVariant                 ItemVariant                  @relation(fields: [itemVariantId], references: [id], onDelete: Restrict)
  purchaseLine                PurchaseLine?                @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  storageLocation             StorageLocation              @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
  uniqueStockUnits            UniqueStockUnit[]
  stockMovements              StockMovement[]
  inventoryReservations       InventoryReservation[]
  orderComponentConsumptions  OrderComponentConsumption[]
  returnComponentDispositions ReturnComponentDisposition[]

  @@index([itemVariantId, receivedDate, id])
  @@map("inventory_lot")
}

model UniqueStockUnit {
  id                          String                       @id @default(uuid()) @db.Uuid
  workspaceId                 String                       @map("workspace_id") @db.Uuid
  itemVariantId               String                       @map("item_variant_id") @db.Uuid
  inventoryLotId              String                       @map("inventory_lot_id") @db.Uuid
  individualCode              String                       @map("individual_code")
  condition                   String
  measurementsJson            Json                         @default("{}") @map("measurements_json")
  acquisitionCostJpy          BigInt                       @map("acquisition_cost_jpy") @db.BigInt
  storageLocationId           String                       @map("storage_location_id") @db.Uuid
  status                      UniqueStockStatus            @default(IN_STOCK)
  memo                        String?
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace                   Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  itemVariant                 ItemVariant                  @relation(fields: [itemVariantId], references: [id], onDelete: Restrict)
  inventoryLot                InventoryLot                 @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict)
  storageLocation             StorageLocation              @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
  stockMovements              StockMovement[]
  salesSkuComponents          SalesSkuComponent[]
  inventoryReservations       InventoryReservation[]
  orderComponentConsumptions  OrderComponentConsumption[]
  returnComponentDispositions ReturnComponentDisposition[]

  @@unique([workspaceId, individualCode])
  @@index([itemVariantId, status])
  @@index([storageLocationId, status])
  @@map("unique_stock_unit")
}

model InventoryCostBalance {
