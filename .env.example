# PostgreSQL (example values only; replace every secret for real use)
POSTGRES_DB=buppancho
POSTGRES_USER=buppancho
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://buppancho:replace-with-a-long-random-password@localhost:5432/buppancho

# Public URL. Production must use HTTPS.
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=localhost:3000

# Backup paths are host-side paths used by Docker Compose.
BACKUP_DIR=./backups
BACKUP_STATUS_DIR=./backup-status
BACKUP_IDENTITY_FILE=./secrets/backup-identity.txt
# Optional path on another drive/device.
BACKUP_MIRROR_DIR=

# Optional future Cloudflare Tunnel. Do not commit a real token.
CLOUDFLARE_TUNNEL_TOKEN=
