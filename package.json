{
  "name": "buppancho",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "物販帳 (Buppancho) - 物販・在庫・会計管理",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && node scripts/test/check-lint-ignores.mjs",
    "typecheck": "prisma generate && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:phase1": "tsx scripts/test/run-phase1.ts",
    "test:phase2": "tsx scripts/test/run-phase1.ts",
    "test:phase2:final": "tsx scripts/test/run-phase2-final.ts",
    "test:phase2:ui": "tsx scripts/test/run-phase2-final.ts --ui",
    "test:redesign": "tsx scripts/test/run-redesign.ts",
    "test:redesign:ui": "tsx scripts/test/run-redesign.ts --ui",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "bootstrap": "tsx scripts/bootstrap/index.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "decimal.js": "10.6.0",
    "dotenv": "17.2.3",
    "fflate": "^0.8.3",
    "lucide-react": "0.536.0",
    "next": "16.4.6",
    "pdfjs-dist": "^6.5.438",
    "pg": "8.16.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
